---
import Base from '../layouts/Base.astro';
import Section3App from '../components/Section3App';
---

<Base title="Global Diaspora - Slovak Brain Drain" lang="en">
  <Section3App client:load />
</Base>

<style is:global>
  main {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  body { overflow-x: hidden; }

  /* ─── The diaspora figure ────────────────────────────────────── */
  /* Inverted 2026-08: Europe is the primary frame and the world is a locator in
     the side rail. The previous arrangement was a full-bleed world map with a
     floating European inset, and it failed five ways: the map exceeded the
     viewport so the readout below it was never on screen with it, the inset
     occluded the land it floated over, the legend collided with data in every
     corner it could be placed in, and four symbol conventions competed for the
     reader. 93.8 percent of the data is inside the European frame. */

  .diaspora-figure {
    margin: 0 0 var(--space-16);
  }

  /* The head sits ABOVE the map, in the prose column, so the map is not
     full-bleed-with-no-title. */
  .diaspora-head {
    max-width: var(--max-prose);
    margin: 0 auto var(--space-6);
    padding: var(--space-16) var(--space-6) 0;
  }
  .diaspora-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 var(--space-6) 0;
  }
  .diaspora-title {
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 500;
    line-height: 1.15;
    color: var(--text-primary);
    margin: 0 0 var(--space-3) 0;
  }
  .diaspora-subtitle {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* The stage: map and readout side by side, in one grid, inside the content
     column. Both are therefore on screen together at any viewport taller than
     about 640px, which is the defect the stacked layout could not fix: the map
     was 100vw wide and full-bleed, so it was always taller than the fold and the
     readout was always below it.

     No fixed height and no 100vh. The height is whatever the 760x546 viewBox
     resolves to at the column width, which at 1080px content minus a 300px rail
     is about 540px of map. */
  .diaspora-stage {
    position: relative;
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-6);
    align-items: start;
  }
  .diaspora-primary { min-width: 0; }
  .diaspora-eu-svg {
    display: block;
    width: 100%;
    height: auto;
    /* The window's own natural aspect under LAEA, 760/546. Authored as the ratio
       rather than a rounded decimal so it cannot drift from the viewBox. */
    aspect-ratio: 760 / 546;
    background: var(--accent-secondary-light);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }
  .diaspora-disc { cursor: pointer; }
  .diaspora-disc:focus-visible {
    outline: 2px solid var(--accent-secondary);
    outline-offset: 2px;
  }

  /* Slovakia, as a label rather than a glyph. paint-order draws the cream stroke
     under the letterforms, so it stays legible over land and over the edge of
     Czechia's disc without needing a plate behind it. */
  .diaspora-origin-label {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    fill: var(--text-primary);
    stroke: #FBF7F0;
    stroke-width: 3.2px;
    paint-order: stroke fill;
    pointer-events: none;
  }

  /* ─── Side rail: readout, legend, locator ────────────────────── */
  .diaspora-rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }

  /* The readout is the first thing in the rail, beside the map rather than under
     it, so a click has feedback at roughly the height of the thing clicked. */
  .diaspora-readout {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .diaspora-readout-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 var(--space-2) 0;
  }
  .diaspora-readout-value {
    font-family: var(--font-serif);
    font-size: 38px;
    font-weight: 500;
    line-height: 1;
    color: var(--text-primary);
    margin: 0;
  }
  .diaspora-readout-sub,
  .diaspora-readout-note {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: var(--space-2) 0 0 0;
  }
  .diaspora-readout-note { color: var(--text-tertiary); }

  /* Legend: in the rail, on cream, over nothing. It used to float in a corner of
     the map, and measured against the rendered European frame there is no corner
     free of data: bottom-left hits France and Portugal, bottom-right hits Turkey
     and Cyprus, top-left hits Iceland.

     One basis only. The disc ticks are round scale anchors (1k / 20k / 100k),
     not countries. The old top tick was 113,773, which is Czechia, whose figure
     is the citizenship-basis outlier the section's argument turns on, so the
     legend for a birthplace map was keyed to a non-birthplace number. */
  .diaspora-legend {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .diaspora-legend-title {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 var(--space-2) 0;
  }
  .diaspora-legend-bubbles {
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .diaspora-legend-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .diaspora-legend-disc {
    display: block;
    border-radius: 50%;
    /* Single fill, matching the map. The log ramp is gone. */
    background: var(--accent-primary);
    opacity: 0.72;
    border: 0.6px solid rgba(251, 247, 240, 0.9);
  }
  .diaspora-legend-tick {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-secondary);
  }
  .diaspora-legend-flag {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 11px;
    line-height: 1.35;
    color: var(--text-secondary);
    margin: var(--space-2) 0 0 0;
  }
  /* One swatch now, not three. Inline SVG, drawn the way the map draws it: a CSS
     border on a circle this small does not survive, and the solid-versus-dashed
     ring pair it replaced could not be told apart at 15px anyway. */
  .diaspora-legend-mark {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    display: block;
    overflow: visible;
  }

  /* ─── World locator ──────────────────────────────────────────── */
  /* Carries the 16 destinations outside the European frame, 6.2 percent of the
     total, and the United States annotation. Same disc scale as the main frame:
     both viewBoxes are authored at 1 unit = 1px at full size, so one legend
     serves both and a disc means the same thing in each. */
  .diaspora-locator-title {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 var(--space-2) 0;
  }
  .diaspora-locator-svg {
    display: block;
    width: 100%;
    height: auto;
    /* Natural Earth 1's own aspect at this frame, 300/131. */
    aspect-ratio: 300 / 131;
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
  }
  /* The European window, so the locator says where the primary figure is. */
  .diaspora-window-outline {
    fill: none;
    stroke: var(--accent-primary);
    stroke-width: 1.1;
    stroke-dasharray: 3 2;
    pointer-events: none;
  }
  .diaspora-locator-note,
  .diaspora-absent {
    font-family: var(--font-sans);
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--text-tertiary);
    margin: var(--space-2) 0 0 0;
  }
  /* HTML, not SVG text: it wraps, and it scales with the reader's type size
     rather than with the width of the frame. The old version authored its line
     breaks by hand in the content module and needed a mobile font-size override
     to stay legible. */
  .diaspora-absent-title {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .diaspora-rail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  /* Cursor-following tooltip, per 05-design.md: cream surface, subtle border,
     one floating shadow. Not the old dark panel. */
  .diaspora-tip {
    position: absolute;
    z-index: 3;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 8px 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-floating);
    max-width: 220px;
  }
  .diaspora-tip-name {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
  }
  .diaspora-tip-value {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }
  .diaspora-tip-basis {
    font-family: var(--font-sans);
    font-size: 11px;
    line-height: 1.35;
    color: var(--accent-primary-hover);
    margin-top: 2px;
  }

  /* The "click a country to zoom in" chip is gone with the zoom, and the detail
     card that used to sit below the map is now .diaspora-readout in the rail. */
  .diaspora-src {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    margin: 0;
  }
  .diaspora-reset {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--accent-primary);
    background: none;
    border: none;
    border-bottom: 1px solid currentColor;
    padding: 0;
    cursor: pointer;
  }
  .diaspora-reset:hover { color: var(--accent-primary-hover); }

  .section3-notice-top {
    max-width: var(--max-prose);
    margin: var(--space-6) auto 0;
    padding: var(--space-3) var(--space-4);
    background: var(--accent-tertiary-light);
    border-left: 2px solid var(--border-emphasis);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* ─── Editorial ──────────────────────────────────────────────── */
  .section3-editorial {
    padding: var(--space-16) var(--space-16) var(--space-24);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .section3-header {
    max-width: var(--max-prose);
    margin: 0 auto;
  }
  .section3-h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 42px;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0;
  }
  .section3-prose {
    max-width: var(--max-prose);
    margin: 0 auto;
  }
  .section3-prose p {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0 0 1.25rem 0;
  }
  .section3-prose p:last-child { margin-bottom: 0; }
  .section3-chart-wide {
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
  }
  .section3-caption {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    margin-top: var(--space-2);
  }
  .section3-h3 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--text-primary);
    max-width: var(--max-prose);
    margin: 0 auto;
    text-align: center;
  }
  .section3-closing { margin-top: var(--space-8); }
  /* Understated by design: a limitation, not a finding. */
  .section3-data-note {
    max-width: var(--max-prose);
    margin: 0 auto;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-tertiary);
  }
  .section-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    margin: 0 0 var(--space-6) 0;
  }
  .stat-callout {
    max-width: var(--max-prose);
    margin: 0 auto;
    text-align: center;
  }
  .stat-callout-value {
    font-family: var(--font-serif);
    font-size: 72px;
    font-weight: 400;
    color: var(--accent-primary);
    line-height: 1;
    margin: 0;
  }
  .stat-callout-label {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-secondary);
    margin: var(--space-3) 0 0 0;
  }
  .section3-translation-notice {
    max-width: var(--max-content);
    margin: 0 auto var(--space-8);
    padding: var(--space-3) var(--space-4);
    background: var(--accent-tertiary-light);
    border-left: 3px solid var(--accent-tertiary);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-secondary);
  }

  /* ─── About this data ────────────────────────────────────────── */
  .chart-caption-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .chart-caption-row .section3-caption {
    margin-top: 0;
    flex: 1 1 auto;
  }
  .about-data-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    background: none;
    border: none;
    padding: 2px 0;
    cursor: pointer;
    transition: color var(--duration-fast) var(--easing-default);
  }
  .about-data-trigger:hover { color: var(--accent-primary); }
  .about-data-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1px solid currentColor;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 10px;
    line-height: 1;
  }
  .about-data-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(42, 24, 16, 0.32);
    backdrop-filter: blur(2px);
    display: flex;
    justify-content: flex-end;
    animation: about-fade var(--duration-fast) var(--easing-default);
  }
  @keyframes about-fade { from { opacity: 0; } to { opacity: 1; } }
  .about-data-panel {
    position: relative;
    width: min(420px, 100%);
    height: 100%;
    overflow-y: auto;
    background: var(--bg-surface);
    box-shadow: var(--shadow-floating);
    padding: var(--space-16) var(--space-8) var(--space-8);
    animation: about-slide var(--duration-base) var(--easing-decelerate);
  }
  @keyframes about-slide { from { transform: translateX(24px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  .about-data-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 32px;
    height: 32px;
    font-size: 24px;
    line-height: 1;
    color: var(--text-tertiary);
    background: none;
    border: none;
    cursor: pointer;
  }
  .about-data-close:hover { color: var(--text-primary); }
  .about-data-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0 0 var(--space-6) 0;
  }
  .about-data-heading {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin: var(--space-6) 0 var(--space-2) 0;
  }
  .about-data-body {
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-primary);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-data-overlay, .about-data-panel { animation: none; }
  }

  /* ─── Narrow: the rail stops being a rail ────────────────────── */
  /* Below this the 300px rail squeezes the map to under 500px, at which point
     Slovenia's disc is a smudge. Everything becomes one column.

     The order matters and a plain source order will not give it. The readout must
     stay ADJACENT to the map, because it is the feedback for tapping it: the
     first attempt at this breakpoint reordered .diaspora-rail as a block, which
     left the legend and the locator sitting between the readout and the map and
     pushed the map 1038px down a 844px viewport, reintroducing the defect in a
     new place. So the stage is one grid and the rail's three children are
     promoted into it with `display: contents`, which lets them be ordered
     against the map itself rather than only against each other:

       1 readout   2 map   3 legend   4 locator   5 meta                       */
  @media (max-width: 900px) {
    .diaspora-stage {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
    .diaspora-rail { display: contents; }
    .diaspora-readout { order: 1; border-bottom: none; padding-bottom: 0; }
    .diaspora-primary { order: 2; }
    .diaspora-legend { order: 3; }
    .diaspora-locator { order: 4; }
    .diaspora-rail-meta { order: 5; }
    .diaspora-readout-value { font-size: 32px; }
  }

  @media (max-width: 640px) {
    .diaspora-stage { padding: 0 var(--space-4); }
    /* SVG user units against a 760-wide viewBox: at a 392px frame this label
       would render near 6.7px. Scaled to hold roughly its desktop apparent size,
       which is the one thing in the figure that cannot be HTML, because it is
       pinned to a projected coordinate. */
    .diaspora-origin-label { font-size: 21px; stroke-width: 5px; }
    /* The locator is 300 units wide and already near its floor here, so the tail
       discs are given a little more frame rather than less. */
    .diaspora-locator-svg { max-width: 420px; }
  }

  /* ─── Mobile ─────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .section3-editorial {
      padding: var(--space-8) var(--space-4) var(--space-16);
      gap: var(--space-8);
    }
    .section3-h1 { font-size: 32px; }
    .section3-prose p { font-size: 16px; }
    .section3-h3 { font-size: 20px; }
    .stat-callout-value { font-size: 52px; }
    .about-data-panel {
      width: 100%;
      padding: var(--space-12) var(--space-4) var(--space-6);
    }
  }
</style>

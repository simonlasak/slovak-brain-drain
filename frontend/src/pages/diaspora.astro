---
import Base from '../layouts/Base.astro';
import Section3App from '../components/Section3App';
---

<Base title="Global Diaspora - Slovak Brain Drain" lang="en">
  <Section3App client:load />
</Base>

<style is:global>
  main {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  body { overflow-x: hidden; }

  /* ─── The diaspora figure ────────────────────────────────────── */
  /* Inverted 2026-08: Europe is the primary frame and the world is a locator in
     the side rail. The previous arrangement was a full-bleed world map with a
     floating European inset, and it failed five ways: the map exceeded the
     viewport so the readout below it was never on screen with it, the inset
     occluded the land it floated over, the legend collided with data in every
     corner it could be placed in, and four symbol conventions competed for the
     reader. 93.8 percent of the data is inside the European frame. */

  .diaspora-figure {
    margin: 0 0 var(--space-16);
  }

  /* The head sits ABOVE the map, in the prose column, so the map is not
     full-bleed-with-no-title. */
  /* Aligned to the CONTENT column, not the prose column: at 1440 the head used to
     start 180px right of the map's left edge, because it was max-prose (720) and
     the stage is max-content (1080), both centred. Space above cut from 64px to
     32px, which is most of what was pushing the map under the fold. */
  .diaspora-head {
    max-width: var(--max-content);
    margin: 0 auto var(--space-4);
    padding: var(--space-8) var(--space-6) 0;
  }
  .diaspora-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 var(--space-3) 0;
  }
  .diaspora-title {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 500;
    line-height: 1.15;
    color: var(--text-primary);
    margin: 0 0 var(--space-2) 0;
  }
  /* One line at this column width. The three facts the old three-line subtitle
     carried are all on screen elsewhere: coverage and percentage in the locator
     caption, the ring split named here and keyed in the strip. */
  .diaspora-subtitle {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0;
    max-width: 104ch;
  }

  /* The stage: two rows.

     Row 1 is the Europe map with a locator column beside it. Row 2 is a single
     full-width strip under both, carrying the total, the disc scale, the ring key
     and About this data. Putting those in the strip rather than in the right
     column is what lets the locator column be only as tall as the map, and stops
     the readout from competing with the map for horizontal space.

     No fixed height and no 100vh anywhere. The map's height follows its own
     aspect-ratio at whatever width the column gives it. */
  .diaspora-stage {
    position: relative;
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .diaspora-primary { min-width: 0; }
  .diaspora-eu-svg {
    display: block;
    width: 100%;
    height: auto;
    /* aspect-ratio and max-width are both set inline: the viewBox is measured from
       land and discs at runtime, so neither is a constant. max-width is the width
       the height budget buys, and margin-inline centres what is left over.

       The leftover is the cost of the height cap. This window is 1.17 aspect, so a
       map filling the 1032px column would be 881px tall and push the strip off a
       900px viewport. Height was the binding constraint, so the map is capped and
       centred instead. */
    margin-inline: auto;
    background: var(--accent-secondary-light);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }
  .diaspora-disc { cursor: pointer; }
  .diaspora-disc:focus-visible {
    outline: 2px solid var(--accent-secondary);
    outline-offset: 2px;
  }

  /* The whole country is the hit target, not just the disc. Fifteen of the
     thirty-five discs sit at the 2.4-unit floor, so the mark alone was never a
     realistic target. Countries with a figure get the pointer; the rest do not, so
     the cursor itself tells you what is clickable. */
  .diaspora-land-data { cursor: pointer; }

  /* Hover and selection highlight: the active country's edges, drawn above the
     discs so a neighbour's mark cannot bury it. Unfilled, because area is the
     quantitative channel and a tint would sit over the disc being judged.

     Tatra blue, NOT the dark stroke Slovakia's outline uses. They are different
     claims: dark means "this is the origin, permanently", blue means "this is what
     your cursor is on". Rendered in the same dark ink they read as one convention,
     which is the confusion this figure has already been through once with the
     solid and dashed rings. Blue is also what focus-visible uses here, so
     interaction state has a single colour. */
  .diaspora-active-shape {
    fill: none;
    stroke: var(--accent-secondary);
    stroke-width: 2;
    stroke-linejoin: round;
    pointer-events: none;
  }

  /* Slovakia: a label with a leader tick to its centroid, dropped below the
     Czechia-Austria-Hungary pile. Beside Czechia's disc it read as a label for
     that disc, which is the one reading that must not happen: Slovakia is the
     origin, the only country here with no disc at all.

     paint-order draws the cream stroke under the letterforms, so the label stays
     legible over land without needing a plate behind it. */
  .diaspora-origin-label {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    fill: var(--text-primary);
    stroke: #FBF7F0;
    stroke-width: 3.2px;
    paint-order: stroke fill;
    pointer-events: none;
  }
  /* Thin, and stopping short of both ends, so it reads as an anchor rather than
     as a pointer at a value. */
  .diaspora-origin-tick {
    stroke: var(--text-primary);
    stroke-width: 0.9;
    pointer-events: none;
  }
  /* Slovakia's outline: what the label actually labels. The gold country strokes
     around it are 0.5 at 50% opacity, so 1.3 solid dark reads as deliberate
     without becoming a third mark in the disc alphabet. Faint terracotta wash ties
     it to the section's accent without competing with the discs' 0.72 fill. */
  /* Unfilled: it sits above the discs, so any fill would mask the area of the disc
     beneath it, and area is the one quantitative channel here. Stroke only. */
  .diaspora-origin-shape {
    fill: none;
    stroke: var(--text-primary);
    stroke-width: 1.4;
    pointer-events: none;
  }

  /* ─── The strip: locator | readout | scale ───────────────────── */
  /* Three cells directly under the map. Rules between them rather than boxes: this
     sits on cream, not over the map, so it needs no surface of its own.

     The locator cell is widest because it carries a map plus two paragraphs; the
     readout and the scale need less. */
  .diaspora-strip {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr) minmax(0, 0.9fr);
    align-items: start;
    gap: var(--space-5, 20px);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }
  .diaspora-strip > * + * {
    padding-left: var(--space-5, 20px);
    border-left: 1px solid var(--border-subtle);
  }

  /* The readout sits in the middle cell, directly under the map, so a click has
     feedback on the same screen rather than a scroll away. It always renders: the
     total when nothing is selected, the country when something is. An empty cell
     in a three-way strip reads as broken. */
  .diaspora-readout { min-width: 0; }

  /* Source and About, full width beneath the strip. */
  .diaspora-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }
  .diaspora-readout-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 var(--space-2) 0;
  }
  .diaspora-readout-value {
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 500;
    line-height: 1;
    color: var(--text-primary);
    margin: 0;
  }
  .diaspora-readout-sub,
  .diaspora-readout-note {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: var(--space-2) 0 0 0;
    max-width: 44ch;
  }
  .diaspora-readout-note { color: var(--text-tertiary); }

  /* Legend: in the strip, on cream, over nothing. It used to float in a corner of
     the map, and measured against the rendered European frame there is no corner
     free of data: bottom-left hits France and Portugal, bottom-right hits Turkey
     and Cyprus, top-left hits Iceland.

     One basis only. The disc ticks are round scale anchors (1k / 20k / 100k),
     not countries. The old top tick was 113,773, which is Czechia, whose figure
     is the citizenship-basis outlier the section's argument turns on, so the
     legend for a birthplace map was keyed to a non-birthplace number. */
  .diaspora-legend { min-width: 0; }
  .diaspora-legend-title {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 var(--space-2) 0;
  }
  .diaspora-legend-bubbles {
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .diaspora-legend-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .diaspora-legend-disc {
    display: block;
    border-radius: 50%;
    /* Single fill, matching the map. The log ramp is gone. */
    background: var(--accent-primary);
    opacity: 0.72;
    border: 0.6px solid rgba(251, 247, 240, 0.9);
  }
  .diaspora-legend-tick {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-secondary);
  }
  .diaspora-legend-flag {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 11px;
    line-height: 1.35;
    color: var(--text-secondary);
    margin: var(--space-2) 0 0 0;
  }
  /* One swatch now, not three. Inline SVG, drawn the way the map draws it: a CSS
     border on a circle this small does not survive, and the solid-versus-dashed
     ring pair it replaced could not be told apart at 15px anyway. */
  .diaspora-legend-mark {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    display: block;
    overflow: visible;
  }

  /* ─── World locator ──────────────────────────────────────────── */
  /* Carries the 16 destinations outside the European frame, 6.2 percent of the
     total, and the United States annotation. Same disc scale as the main frame:
     both viewBoxes are authored at 1 unit = 1px at full size, so one legend
     serves both and a disc means the same thing in each. */
  .diaspora-locator-title {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 var(--space-2) 0;
  }
  .diaspora-locator-svg {
    display: block;
    width: 100%;
    height: auto;
    /* Natural Earth 1 cropped to lat -36..72, which is this frame's aspect. Kept
       in sync with LOC_W / LOC_H in the component. */
    aspect-ratio: 300 / 102;
    /* Capped so the cell's total height clears the fold. At 330px the frame is
       112px tall; letting it fill a 380px cell costs another 17px of the budget
       for no legibility gain, since the tail discs are already well above their
       floor. */
    max-width: 330px;
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
  }
  /* The European window, so the locator says where the primary figure is. */
  .diaspora-window-outline {
    fill: none;
    stroke: var(--accent-primary);
    stroke-width: 1.1;
    stroke-dasharray: 3 2;
    pointer-events: none;
  }
  /* Tight leading and small margins: this cell carries a map and two paragraphs
     inside the strip's height budget, and it is the element that decides whether
     the strip clears the fold. */
  .diaspora-locator-note,
  .diaspora-absent {
    font-family: var(--font-sans);
    font-size: 11.5px;
    line-height: 1.42;
    color: var(--text-tertiary);
    margin: 6px 0 0 0;
  }
  /* HTML, not SVG text: it wraps, and it scales with the reader's type size
     rather than with the width of the frame. The old version authored its line
     breaks by hand in the content module and needed a mobile font-size override
     to stay legible. */
  .diaspora-absent-title {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .diaspora-locator { min-width: 0; }

  /* Cursor-following tooltip, per 05-design.md: cream surface, subtle border,
     one floating shadow. Not the old dark panel. */
  .diaspora-tip {
    position: absolute;
    z-index: 3;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 8px 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-floating);
    max-width: 220px;
  }
  .diaspora-tip-name {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
  }
  .diaspora-tip-value {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }
  .diaspora-tip-basis {
    font-family: var(--font-sans);
    font-size: 11px;
    line-height: 1.35;
    color: var(--accent-primary-hover);
    margin-top: 2px;
  }

  /* The "click a country to zoom in" chip is gone with the zoom, and the detail
     card that used to sit below the map is now .diaspora-readout in the rail. */
  .diaspora-src {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    margin: 0;
  }
  .diaspora-reset {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--accent-primary);
    background: none;
    border: none;
    border-bottom: 1px solid currentColor;
    padding: 0;
    cursor: pointer;
  }
  .diaspora-reset:hover { color: var(--accent-primary-hover); }

  .section3-notice-top {
    max-width: var(--max-prose);
    margin: var(--space-6) auto 0;
    padding: var(--space-3) var(--space-4);
    background: var(--accent-tertiary-light);
    border-left: 2px solid var(--border-emphasis);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* ─── Editorial ──────────────────────────────────────────────── */
  .section3-editorial {
    padding: var(--space-16) var(--space-16) var(--space-24);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .section3-header {
    max-width: var(--max-prose);
    margin: 0 auto;
  }
  .section3-h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 42px;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0;
  }
  .section3-prose {
    max-width: var(--max-prose);
    margin: 0 auto;
  }
  .section3-prose p {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0 0 1.25rem 0;
  }
  .section3-prose p:last-child { margin-bottom: 0; }
  .section3-chart-wide {
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
  }
  .section3-caption {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    margin-top: var(--space-2);
  }
  .section3-h3 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--text-primary);
    max-width: var(--max-prose);
    margin: 0 auto;
    text-align: center;
  }
  .section3-closing { margin-top: var(--space-8); }
  /* Understated by design: a limitation, not a finding. */
  .section3-data-note {
    max-width: var(--max-prose);
    margin: 0 auto;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-tertiary);
  }
  .section-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    margin: 0 0 var(--space-6) 0;
  }
  .stat-callout {
    max-width: var(--max-prose);
    margin: 0 auto;
    text-align: center;
  }
  .stat-callout-value {
    font-family: var(--font-serif);
    font-size: 72px;
    font-weight: 400;
    color: var(--accent-primary);
    line-height: 1;
    margin: 0;
  }
  .stat-callout-label {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-secondary);
    margin: var(--space-3) 0 0 0;
  }
  .section3-translation-notice {
    max-width: var(--max-content);
    margin: 0 auto var(--space-8);
    padding: var(--space-3) var(--space-4);
    background: var(--accent-tertiary-light);
    border-left: 3px solid var(--accent-tertiary);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-secondary);
  }

  /* ─── About this data ────────────────────────────────────────── */
  .chart-caption-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .chart-caption-row .section3-caption {
    margin-top: 0;
    flex: 1 1 auto;
  }
  .about-data-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    background: none;
    border: none;
    padding: 2px 0;
    cursor: pointer;
    transition: color var(--duration-fast) var(--easing-default);
  }
  .about-data-trigger:hover { color: var(--accent-primary); }
  .about-data-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1px solid currentColor;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 10px;
    line-height: 1;
  }
  .about-data-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(42, 24, 16, 0.32);
    backdrop-filter: blur(2px);
    display: flex;
    justify-content: flex-end;
    animation: about-fade var(--duration-fast) var(--easing-default);
  }
  @keyframes about-fade { from { opacity: 0; } to { opacity: 1; } }
  .about-data-panel {
    position: relative;
    width: min(420px, 100%);
    height: 100%;
    overflow-y: auto;
    background: var(--bg-surface);
    box-shadow: var(--shadow-floating);
    padding: var(--space-16) var(--space-8) var(--space-8);
    animation: about-slide var(--duration-base) var(--easing-decelerate);
  }
  @keyframes about-slide { from { transform: translateX(24px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  .about-data-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 32px;
    height: 32px;
    font-size: 24px;
    line-height: 1;
    color: var(--text-tertiary);
    background: none;
    border: none;
    cursor: pointer;
  }
  .about-data-close:hover { color: var(--text-primary); }
  .about-data-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0 0 var(--space-6) 0;
  }
  .about-data-heading {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin: var(--space-6) 0 var(--space-2) 0;
  }
  .about-data-body {
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-primary);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-data-overlay, .about-data-panel { animation: none; }
  }

  /* ─── Narrow: both rows collapse to one column ───────────────── */
  /* Below this the 316px locator column squeezes the map to under 500px, at which
     point Slovenia's disc is a smudge. Map first, then locator, then the strip
     unrolled vertically.

     The readout stays the first thing in the strip and the strip stays directly
     under the map, so a tap still has feedback on the same screen. An earlier
     attempt at this breakpoint put the legend and locator between the readout and
     the map, pushing the map 1038px down an 844px viewport and reintroducing the
     below-the-fold defect in a new place. */
  @media (max-width: 900px) {
    /* One column, and the strip's cells reorder so the READOUT follows the map
       directly: map, readout, scale, locator. Source order in the DOM is
       locator, readout, scale, which is the desktop reading order left to right;
       `order` re-sorts it here rather than duplicating markup.

       The readout has to be adjacent to the map because it is the feedback for
       tapping it. An earlier attempt at this breakpoint left other cells between
       the two and pushed the map 1038px down an 844px viewport. */
    .diaspora-strip {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
    .diaspora-readout { order: 1; }
    .diaspora-legend { order: 2; }
    .diaspora-locator { order: 3; }
    /* Rules go horizontal when the strip stacks: a left border on a full-width
       row reads as an indent, not as a divider. */
    .diaspora-strip > * + * {
      padding-left: 0;
      border-left: none;
    }
    .diaspora-strip > .diaspora-legend,
    .diaspora-strip > .diaspora-locator {
      padding-top: var(--space-4);
      border-top: 1px solid var(--border-subtle);
    }
    /* The height cap is a desktop concern. Here the map should simply fill the
       column, so the inline max-width is overridden. */
    .diaspora-eu-svg { max-width: 100% !important; }
  }

  @media (max-width: 640px) {
    .diaspora-stage { padding: 0 var(--space-4); }

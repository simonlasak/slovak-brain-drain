---
import Base from '../layouts/Base.astro';
import Section3App from '../components/Section3App';
---

<Base title="Global Diaspora - Slovak Brain Drain" lang="en">
  <Section3App client:load />
</Base>

<style is:global>
  main {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  body { overflow-x: hidden; }

  /* ─── Interactive world map ──────────────────────────────────── */
  /* Rebuilt 2026-08. The previous version shipped a blue-grey (#EDF3F5) ocean
     against a terracotta spec, a dark tooltip duplicating the card, a card
     floating over the ocean, Greenland clipped under the nav, and a hint
     sitting in open water as the only affordance. */

  .diaspora-figure {
    margin: 0 0 var(--space-16);
  }

  /* The head sits ABOVE the map, in the prose column, so the map is not
     full-bleed-with-no-title. */
  .diaspora-head {
    max-width: var(--max-prose);
    margin: 0 auto var(--space-6);
    padding: var(--space-16) var(--space-6) 0;
  }
  .diaspora-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 var(--space-6) 0;
  }
  .diaspora-title {
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 500;
    line-height: 1.15;
    color: var(--text-primary);
    margin: 0 0 var(--space-3) 0;
  }
  .diaspora-subtitle {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* The map is now an inline SVG with an aspect-ratio box rather than a WebGL
     canvas with a pixel height. Nothing attaches a wheel listener, so the page
     scrolls over it: the previous build's scrollZoom trapped the scroll. */
  .diaspora-map-wrap {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    background: var(--accent-secondary-light);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .diaspora-svg {
    display: block;
    width: 100%;
    /* Matches the 1000x500 viewBox, so no letterboxing and no clipped pole. */
    aspect-ratio: 2 / 1;
    height: auto;
  }

  /* ─── European inset ─────────────────────────────────────────── */
  /* 93.5% of the counted total sits inside lon -11..32, lat 34..71, where at
     world scale Czechia's 42px-radius disc covers Austria, Slovakia and Hungary.
     This is what click-to-zoom was compensating for. */
  .diaspora-inset {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: clamp(200px, 26vw, 320px);
    padding: var(--space-3);
    background: rgba(251, 247, 240, 0.96);
    border: 1px solid var(--border-emphasis);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-floating);
  }
  .diaspora-inset-title {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 var(--space-2) 0;
  }
  .diaspora-inset-svg {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
  }
  .diaspora-inset-note {
    font-family: var(--font-sans);
    font-size: 10.5px;
    line-height: 1.45;
    color: var(--text-tertiary);
    margin: var(--space-2) 0 0 0;
  }

  /* United States annotation: an absence, drawn as SVG text inside the map.
     Sizes are SVG USER UNITS against a 1000-wide viewBox, not CSS pixels, so
     they scale with the frame. At a 1600px-wide map 13 units renders near 21px;
     at 430px it renders near 5.6px, which is illegible, so the mobile rule below
     scales them up rather than leaving them to shrink with the map. */
  .diaspora-absent-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    fill: var(--text-secondary);
  }
  .diaspora-absent-note {
    font-family: var(--font-sans);
    font-size: 11px;
    fill: var(--text-tertiary);
  }

  /* Legend: bottom-left, on cream. No colour ramp any more: area is the only
     quantitative channel, so the legend shows sized discs and the two
     definitional marks plus the origin diamond. */
  .diaspora-legend {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    max-width: 280px;
    padding: var(--space-3) var(--space-4);
    background: rgba(251, 247, 240, 0.94);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }
  .diaspora-legend-title {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 var(--space-2) 0;
  }
  .diaspora-legend-bubbles {
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .diaspora-legend-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .diaspora-legend-disc {
    display: block;
    border-radius: 50%;
    /* Single fill, matching the map. The log ramp is gone. */
    background: var(--accent-primary);
    opacity: 0.72;
    border: 0.6px solid rgba(251, 247, 240, 0.9);
  }
  .diaspora-legend-tick {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-secondary);
  }
  .diaspora-legend-flag {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 11px;
    line-height: 1.35;
    color: var(--text-secondary);
    margin: var(--space-2) 0 0 0;
  }
  /* Swatch marks are inline SVG, drawn the same way the map draws them, so the
     solid ring, the dashed ring and the Slovakia diamond stay distinguishable.
     A CSS dashed border on a circle this small does not. */
  .diaspora-legend-mark {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    display: block;
    overflow: visible;
  }

  /* Cursor-following tooltip, per 05-design.md: cream surface, subtle border,
     one floating shadow. Not the old dark panel. */
  .diaspora-tip {
    position: absolute;
    z-index: 3;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 8px 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-floating);
    max-width: 220px;
  }
  .diaspora-tip-name {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
  }
  .diaspora-tip-value {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }
  .diaspora-tip-basis {
    font-family: var(--font-sans);
    font-size: 11px;
    line-height: 1.35;
    color: var(--accent-primary-hover);
    margin-top: 2px;
  }

  /* The "click a country to zoom in" chip is gone with the zoom. Top-right now
     carries the European inset, which answers the question the zoom was for. */

  /* Detail card BELOW the map, in the content column. */
  .diaspora-detail {
    max-width: var(--max-content);
    margin: var(--space-6) auto 0;
    padding: 0 var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-6);
  }
  .diaspora-detail-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0;
    flex: 1 0 100%;
  }
  .diaspora-detail-value {
    font-family: var(--font-serif);
    font-size: 42px;
    font-weight: 500;
    line-height: 1;
    color: var(--text-primary);
    margin: 0;
  }
  .diaspora-detail-sub,
  .diaspora-detail-note {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
    max-width: 52ch;
  }
  .diaspora-detail-note { color: var(--text-tertiary); }
  .diaspora-detail-meta {
    flex: 1 0 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }
  .diaspora-src {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    margin: 0;
  }
  .diaspora-reset {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--accent-primary);
    background: none;
    border: none;
    border-bottom: 1px solid currentColor;
    padding: 0;
    cursor: pointer;
  }
  .diaspora-reset:hover { color: var(--accent-primary-hover); }

  .section3-notice-top {
    max-width: var(--max-prose);
    margin: var(--space-6) auto 0;
    padding: var(--space-3) var(--space-4);
    background: var(--accent-tertiary-light);
    border-left: 2px solid var(--border-emphasis);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* ─── Editorial ──────────────────────────────────────────────── */
  .section3-editorial {
    padding: var(--space-16) var(--space-16) var(--space-24);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .section3-header {
    max-width: var(--max-prose);
    margin: 0 auto;
  }
  .section3-h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 42px;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0;
  }
  .section3-prose {
    max-width: var(--max-prose);
    margin: 0 auto;
  }
  .section3-prose p {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0 0 1.25rem 0;
  }
  .section3-prose p:last-child { margin-bottom: 0; }
  .section3-chart-wide {
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
  }
  .section3-caption {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    margin-top: var(--space-2);
  }
  .section3-h3 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--text-primary);
    max-width: var(--max-prose);
    margin: 0 auto;
    text-align: center;
  }
  .section3-closing { margin-top: var(--space-8); }
  /* Understated by design: a limitation, not a finding. */
  .section3-data-note {
    max-width: var(--max-prose);
    margin: 0 auto;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-tertiary);
  }
  .section-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    margin: 0 0 var(--space-6) 0;
  }
  .stat-callout {
    max-width: var(--max-prose);
    margin: 0 auto;
    text-align: center;
  }
  .stat-callout-value {
    font-family: var(--font-serif);
    font-size: 72px;
    font-weight: 400;
    color: var(--accent-primary);
    line-height: 1;
    margin: 0;
  }
  .stat-callout-label {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-secondary);
    margin: var(--space-3) 0 0 0;
  }
  .section3-translation-notice {
    max-width: var(--max-content);
    margin: 0 auto var(--space-8);
    padding: var(--space-3) var(--space-4);
    background: var(--accent-tertiary-light);
    border-left: 3px solid var(--accent-tertiary);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-secondary);
  }

  /* ─── About this data ────────────────────────────────────────── */
  .chart-caption-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .chart-caption-row .section3-caption {
    margin-top: 0;
    flex: 1 1 auto;
  }
  .about-data-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    background: none;
    border: none;
    padding: 2px 0;
    cursor: pointer;
    transition: color var(--duration-fast) var(--easing-default);
  }
  .about-data-trigger:hover { color: var(--accent-primary); }
  .about-data-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1px solid currentColor;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 10px;
    line-height: 1;
  }
  .about-data-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(42, 24, 16, 0.32);
    backdrop-filter: blur(2px);
    display: flex;
    justify-content: flex-end;
    animation: about-fade var(--duration-fast) var(--easing-default);
  }
  @keyframes about-fade { from { opacity: 0; } to { opacity: 1; } }
  .about-data-panel {
    position: relative;
    width: min(420px, 100%);
    height: 100%;
    overflow-y: auto;
    background: var(--bg-surface);
    box-shadow: var(--shadow-floating);
    padding: var(--space-16) var(--space-8) var(--space-8);
    animation: about-slide var(--duration-base) var(--easing-decelerate);
  }
  @keyframes about-slide { from { transform: translateX(24px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  .about-data-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 32px;
    height: 32px;
    font-size: 24px;
    line-height: 1;
    color: var(--text-tertiary);
    background: none;
    border: none;
    cursor: pointer;
  }
  .about-data-close:hover { color: var(--text-primary); }
  .about-data-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0 0 var(--space-6) 0;
  }
  .about-data-heading {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin: var(--space-6) 0 var(--space-2) 0;
  }
  .about-data-body {
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-primary);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-data-overlay, .about-data-panel { animation: none; }
  }

  /* ─── Mobile ─────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .section3-editorial {
      padding: var(--space-8) var(--space-4) var(--space-16);
      gap: var(--space-8);
    }
    .section3-h1 { font-size: 32px; }
    .section3-prose p { font-size: 16px; }
    .section3-h3 { font-size: 20px; }
    .stat-callout-value { font-size: 52px; }
    .diaspora-card-value { font-size: 2rem; }
    /* Inset and legend stop floating: at this width an overlay covers the map it
       is meant to explain. Both become blocks under it, inset first, because it
       carries 94 percent of the data. */
    .diaspora-inset {
      position: static;
      width: auto;
      margin: var(--space-3) var(--space-4) 0;
      box-shadow: none;
    }
    .diaspora-legend {
      position: static;
      max-width: none;
      margin: var(--space-3) var(--space-4) var(--space-4);
      background: transparent;
      border: none;
      padding: 0;
    }
    /* The US annotation is in SVG user units, so at this width it would render
       around 5.6px. Scaled up to hold roughly the desktop apparent size. The
       note drops to a shorter line via the two-line layout in the component. */
    .diaspora-absent-title { font-size: 34px; }
    .diaspora-absent-note { font-size: 27px; }
    .about-data-panel {
      width: 100%;
      padding: var(--space-12) var(--space-4) var(--space-6);
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import DiamondTransition from '../components/DiamondTransition';
import HeroCounter from '../components/HeroCounter';
// Derived by pipeline/analysis/headline_figures.py. Every number rendered as a
// statistic on this page comes from here, so none of them can be typed in.
import figures from '../data/headline_figures.json';

// The hero and the line beneath it MUST share a window. Both are 2004-2024: the
// mirror comparison cannot speak past 2024, because a destination stock dated
// 1 Jan 2025 only reflects arrivals through 2024. SU SR's fuller 2004-2025 total
// of 64,855 is stated on /methodology, where it can carry that explanation.
const departures = figures.mirror_registered_departures_2004_2024.value;
const czResidents = figures.slovaks_in_cz_residents_2025.value;
const czLabour = figures.slovaks_in_cz_labour_2024.value;
const destinations = figures.diaspora_destinations_un_desa_2020.value;
const mirrorImplied = figures.mirror_implied_departures_2004_2024.value;
const mirrorPanel = figures.mirror_panel_countries.value;
const fmt = (n: number) => n.toLocaleString('en');
---

<Base
  title="Slovak Brain Drain"
  lang="en"
  description="How many people have left Slovakia since 2004, and why the official count is a fraction of the real figure. Four sections of migration data, mapped."
>
  <!-- Zone 1: Hero -->
  <div class="hero">
    <HeroCounter
      client:load
      metric="migr_out"
      geoLevel="nation"
      yearFrom={2004}
      yearTo={2024}
      fallback={departures}
    />
    <p style="font-family: var(--font-sans); font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.14em; color: var(--text-secondary); margin-top: 1.5rem; max-width: 400px;">people Slovak authorities recorded leaving the country between 2004 and 2024</p>
    <p style="font-family: var(--font-sans); font-size: 14px; color: var(--text-tertiary); margin-top: 2rem; max-width: 480px; line-height: 1.6;">It is a fraction of the real figure. Deregistering on departure carries no penalty and no benefit, so most people who leave never do it.</p>
    <p style="font-family: var(--font-sans); font-size: 14px; color: var(--text-tertiary); margin-top: 1.5rem; max-width: 480px; line-height: 1.6;">Over the same years, the {mirrorPanel} destination countries that have counted Slovak citizens throughout imply at least {fmt(mirrorImplied)} departures, and they omit the United Kingdom entirely. <a href="/methodology" style="color: var(--accent-primary);">How that is derived</a>.</p>
    <div style="position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);">
      <DiamondTransition client:load />
    </div>
  </div>

  <p class="sections-eyebrow">Sections / Sekcie</p>

  <section class="sections-grid">
    <a href="/internal" class="section-card">
      <span class="eyebrow">&sect;1 &middot; INTERNAL</span>
      <h2>Internal Slovakia</h2>
      <p>Population change and regional divergence across all 79 districts, 2004-2025.</p>
    </a>
    <a href="/corridor" class="section-card">
      <span class="eyebrow">&sect;2 &middot; CORRIDOR</span>
      <h2>The Czech Corridor</h2>
      <p>{fmt(czResidents)} Slovaks resident in Czechia, and {fmt(czLabour)} in its labour market. Why one country produces two counts.</p>
    </a>
    <a href="/diaspora" class="section-card">
      <span class="eyebrow">&sect;3 &middot; DIASPORA</span>
      <h2>Global Diaspora</h2>
      <p>Slovaks counted in {destinations} countries. How many live abroad depends on what makes someone Slovak.</p>
    </a>
    <a href="/people" class="section-card">
      <span class="eyebrow">&sect;4 &middot; PEOPLE</span>
      <h2>Notable Departures</h2>
      <p>Individual stories that illustrate the structural patterns.</p>
    </a>
  </section>

  <!-- Zone 3: Footer links -->
  <nav class="footer-links">
    <a href="/methodology">Methodology</a>
    <span class="dot">&middot;</span>
    <a href="/resources">Resources</a>
    <span class="dot">&middot;</span>
    <a href="/methodology">About this data</a>
  </nav>
</Base>

<style>
  :global(main) {
    padding-top: 0 !important;
  }
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: calc(100vh - 72px);
    text-align: center;
    padding: 0 1.5rem;
  }

  .sections-eyebrow {
    text-align: center;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .sections-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (max-width: 900px) {
    .sections-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .sections-grid { grid-template-columns: 1fr; }
  }

  .section-card {
    display: block;
    padding: 1rem 1rem 1rem 1.25rem;
    border: 1px solid var(--border-subtle);
    border-left: 2px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    transition: border-left-color var(--duration-fast);
  }
  .section-card:hover {
    border-left-color: var(--accent-primary);
  }
  .eyebrow {
    display: block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    margin-bottom: 0.25rem;
  }
  .section-card h2 {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .section-card p {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    line-height: 1.45;
  }

  .footer-links {
    text-align: center;
    margin-top: 3rem;
    padding-bottom: 3rem;
    font-size: 14px;
    color: var(--text-secondary);
  }
  .footer-links a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast);
  }
  .footer-links a:hover {
    color: var(--accent-primary);
  }
  .dot {
    color: var(--text-tertiary);
    margin: 0 0.5rem;
  }
</style>

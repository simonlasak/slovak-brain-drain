---
import Base from '../layouts/Base.astro';
---

<Base title="Wave Options" lang="en">
  <div style="max-width: 800px; margin: 0 auto; padding: 2rem 0;">

    <h2 style="font-family: var(--font-serif); margin-bottom: 1rem;">Option 1: Static sine wave (single path)</h2>
    <svg viewBox="0 0 800 60" width="100%" height="60" preserveAspectRatio="none">
      <path
        d="M0,30 C50,10 100,50 150,30 C200,10 250,50 300,30 C350,10 400,50 450,30 C500,10 550,50 600,30 C650,10 700,50 750,30 C800,10 800,30 800,30"
        fill="none"
        stroke="var(--accent-primary)"
        stroke-width="2"
        stroke-opacity="0.5"
      />
    </svg>

    <div style="height: 4rem;"></div>

    <h2 style="font-family: var(--font-serif); margin-bottom: 1rem;">Option 2: Layered parallax waves (two paths, different speeds)</h2>
    <div style="position: relative; height: 60px; overflow: hidden;">
      <svg class="wave-layer wave-back" viewBox="0 0 1600 60" preserveAspectRatio="none" style="position: absolute; top: 0; left: 0; width: 200%; height: 100%;">
        <path
          d="M0,30 C100,10 200,50 300,30 C400,10 500,50 600,30 C700,10 800,50 900,30 C1000,10 1100,50 1200,30 C1300,10 1400,50 1500,30 C1600,10 1600,30 1600,30"
          fill="none"
          stroke="var(--accent-secondary)"
          stroke-width="1.5"
          stroke-opacity="0.3"
        />
      </svg>
      <svg class="wave-layer wave-front" viewBox="0 0 1600 60" preserveAspectRatio="none" style="position: absolute; top: 0; left: 0; width: 200%; height: 100%;">
        <path
          d="M0,35 C80,15 160,55 240,35 C320,15 400,55 480,35 C560,15 640,55 720,35 C800,15 880,55 960,35 C1040,15 1120,55 1200,35 C1280,15 1360,55 1440,35 C1520,15 1600,35 1600,35"
          fill="none"
          stroke="var(--accent-primary)"
          stroke-width="2"
          stroke-opacity="0.5"
        />
      </svg>
    </div>

    <div style="height: 4rem;"></div>

    <h2 style="font-family: var(--font-serif); margin-bottom: 1rem;">Option 3: Filled layered waves (like a tide line)</h2>
    <div style="position: relative; height: 80px; overflow: hidden;">
      <svg class="wave-layer wave-back" viewBox="0 0 1600 80" preserveAspectRatio="none" style="position: absolute; top: 0; left: 0; width: 200%; height: 100%;">
        <path
          d="M0,40 C100,20 200,60 300,40 C400,20 500,60 600,40 C700,20 800,60 900,40 C1000,20 1100,60 1200,40 C1300,20 1400,60 1500,40 L1600,40 L1600,80 L0,80 Z"
          fill="var(--accent-secondary)"
          fill-opacity="0.08"
        />
      </svg>
      <svg class="wave-layer wave-front" viewBox="0 0 1600 80" preserveAspectRatio="none" style="position: absolute; top: 0; left: 0; width: 200%; height: 100%;">
        <path
          d="M0,45 C80,25 160,65 240,45 C320,25 400,65 480,45 C560,25 640,65 720,45 C800,25 880,65 960,45 C1040,25 1120,65 1200,45 C1280,25 1360,65 1440,45 L1600,45 L1600,80 L0,80 Z"
          fill="var(--accent-primary)"
          fill-opacity="0.06"
        />
      </svg>
    </div>

    <div style="height: 4rem;"></div>

    <h2 style="font-family: var(--font-serif); margin-bottom: 1rem;">Option 4: Gentle single wave with fade-out ends</h2>
    <svg viewBox="0 0 800 40" width="100%" height="40" preserveAspectRatio="none">
      <defs>
        <linearGradient id="wave-fade" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--accent-primary)" stop-opacity="0" />
          <stop offset="20%" stop-color="var(--accent-primary)" stop-opacity="0.5" />
          <stop offset="50%" stop-color="var(--accent-primary)" stop-opacity="0.6" />
          <stop offset="80%" stop-color="var(--accent-primary)" stop-opacity="0.5" />
          <stop offset="100%" stop-color="var(--accent-primary)" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path
        d="M0,20 C50,8 100,32 150,20 C200,8 250,32 300,20 C350,8 400,32 450,20 C500,8 550,32 600,20 C650,8 700,32 750,20 C800,20 800,20 800,20"
        fill="none"
        stroke="url(#wave-fade)"
        stroke-width="2"
      />
    </svg>

    <div style="height: 4rem;"></div>

    <h2 style="font-family: var(--font-serif); margin-bottom: 1rem;">Option 5: Animated generative wave (JS-computed, subtle motion)</h2>
    <div id="gen-wave" style="height: 60px; width: 100%;"></div>

  </div>
</Base>

<style>
  .wave-back {
    animation: wave-drift-slow 12s linear infinite;
  }
  .wave-front {
    animation: wave-drift-fast 8s linear infinite;
  }
  @keyframes wave-drift-slow {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes wave-drift-fast {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wave-back, .wave-front { animation: none; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var container = document.getElementById('gen-wave');
    if (!container) return;

    var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 800 60');
    svg.setAttribute('width', '100%');
    svg.setAttribute('height', '60');
    svg.setAttribute('preserveAspectRatio', 'none');
    svg.style.display = 'block';
    container.appendChild(svg);

    var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke', '#B83A1F');
    path.setAttribute('stroke-width', '2');
    path.setAttribute('stroke-opacity', '0.5');
    svg.appendChild(path);

    var phase = 0;
    function animate() {
      phase += 0.015;
      var points = [];
      for (var x = 0; x <= 800; x += 4) {
        var y = 30 + Math.sin((x / 80) + phase) * 12 + Math.sin((x / 120) + phase * 0.7) * 6;
        points.push(x === 0 ? 'M' + x + ',' + y.toFixed(1) : 'L' + x + ',' + y.toFixed(1));
      }
      path.setAttribute('d', points.join(' '));
      requestAnimationFrame(animate);
    }
    animate();
  });
</script>

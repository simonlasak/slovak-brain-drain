---
import Base from '../layouts/Base.astro';
import CorridorWaveApp from '../components/CorridorWaveApp';
---

<Base title="Czech Corridor (wave) - Slovak Brain Drain" lang="en">
  <CorridorWaveApp client:load />
</Base>

<style is:global>
  main {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  body { overflow-x: hidden; }

  .wave-layer-back {
    animation: wave-drift-slow 12s linear infinite;
  }
  .wave-layer-front {
    animation: wave-drift-fast 8s linear infinite;
  }
  @keyframes wave-drift-slow {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes wave-drift-fast {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wave-layer-back, .wave-layer-front { animation: none; }
  }
</style>

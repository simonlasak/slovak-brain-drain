---
interface Props {
  title: string;
  lang?: 'sk' | 'en';
  /** Meta description. Optional here only so no page can render without one. */
  description?: string;
  /**
   * Set on pages that must never be indexed even once robots.txt opens up, which
   * today means the 404 page alone. It also suppresses the canonical link, since
   * an error page declaring itself canonical is a contradiction.
   */
  noindex?: boolean;
}

// Project-level fallback. Every page passes its own, but a new page that forgets
// still ships a truthful description rather than none.
const DEFAULT_DESCRIPTION =
  'A data-journalism investigation of Slovak emigration since 2004, built from Slovak, Czech, Eurostat, OECD and UN statistical sources.';
const SITE_NAME = 'Slovenský odliv / Slovak Brain Drain';

// Imported (not a bare <link href="/src/...">) so Astro bundles and hashes it.
// A raw /src/ path resolves in dev but 404s in the built site, which silently
// dropped every design token in production.
import '../styles/tokens.css';
import '../styles/charts.css';

const {
  title,
  lang = 'sk',
  description = DEFAULT_DESCRIPTION,
  noindex = false,
} = Astro.props;
const currentPath = Astro.url.pathname;

// Astro.site is undefined when `site` is missing from astro.config.mjs, and
// `new URL(path, undefined)` throws, which would fail the whole build. Fall back
// to the bare pathname so canonical/og:url degrade instead of crashing.
const canonicalURL = Astro.site
  ? new URL(currentPath, Astro.site).href
  : currentPath;

const navItems = [
  { href: '/internal', label: { sk: 'Domáca', en: 'Internal' } },
  { href: '/corridor', label: { sk: 'Československá', en: 'Corridor' } },
  { href: '/diaspora', label: { sk: 'Svetová', en: 'Diaspora' } },
  { href: '/people', label: { sk: 'Ľudia', en: 'People' } },
  { href: '/resources', label: { sk: 'Zdroje', en: 'Resources' } },
  { href: '/methodology', label: { sk: 'Metodológia', en: 'Methodology' } },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang === 'sk' ? 'sk_SK' : 'en_GB'} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <!-- summary, not summary_large_image: there is no OG image asset yet, and
         summary_large_image with no image renders as a broken card. -->
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
    <script is:inline>
      // Set the active locale before first paint to avoid a flash of the
      // wrong language. Mirrors DEFAULT_LOCALE / STORAGE_KEY in src/lib/locale.ts.
      (function () {
        var stored = null;
        try { stored = window.localStorage.getItem('sbd-locale'); } catch (e) {}
        var loc = stored === 'sk' || stored === 'en' ? stored : 'en';
        document.documentElement.lang = loc;
        document.documentElement.setAttribute('data-locale', loc);
      })();
    </script>
    <style is:global>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: var(--font-sans);
        color: var(--text-primary);
        background: var(--bg-page);
        line-height: 1.6;
      }
      @keyframes ebb-drift {
        0%   { transform: translateX(0);   opacity: 0.6; }
        50%  { transform: translateX(6px); opacity: 0.3; }
        100% { transform: translateX(0);   opacity: 0.6; }
      }
      .masthead-diamond {
        animation: ebb-drift 8s ease-in-out infinite;
      }
      @media (prefers-reduced-motion: reduce) {
        .masthead-diamond { animation: none; opacity: 0.6; }
      }
    </style>
    <style>
      nav {
        position: sticky;
        top: 0;
        z-index: 100;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 var(--space-16);
        background: var(--bg-page);
        border-bottom: 1px solid var(--border-subtle);
      }
      @media (max-width: 1024px) {
        nav { padding: 0 var(--space-6); }
      }

      .masthead {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 18px;
        font-weight: 400;
        color: var(--text-primary);
        letter-spacing: -0.01em;
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .masthead:hover { color: var(--text-primary); }
      .masthead-diamond {
        display: inline-block;
        font-style: normal;
        font-size: 10px;
        margin-left: 12px;
        opacity: 0.6;
        vertical-align: middle;
        color: var(--accent-primary);
      }

      .nav-items {
        display: flex;
        align-items: center;
        gap: var(--space-8);
      }
      .nav-items a {
        position: relative;
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--text-secondary);
        text-decoration: none;
        white-space: nowrap;
        padding: 0;
        height: 72px;
        display: flex;
        align-items: center;
        transition: color var(--duration-fast) var(--easing-default);
      }
      .nav-items a:hover {
        color: var(--text-primary);
      }
      .nav-items a.active {
        color: var(--text-primary);
      }
      .nav-items a.active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--accent-primary);
      }

      .locale-toggle {
        display: flex;
        align-items: center;
        font-family: var(--font-sans);
        font-size: 14px;
        flex-shrink: 0;
      }
      .locale-btn {
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 400;
        color: var(--text-tertiary);
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        transition: color var(--duration-fast) var(--easing-default);
      }
      .locale-btn:hover {
        color: var(--text-primary);
      }
      .locale-btn.locale-active {
        color: var(--text-primary);
        font-weight: 500;
        cursor: default;
      }
      .locale-separator {
        color: var(--text-tertiary);
        font-weight: 400;
        margin: 0 6px;
      }

      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }

      /* Hamburger button. Hidden on desktop, where the full nav is visible. */
      .nav-toggle {
        display: none;
        position: relative;
        width: 44px;
        height: 44px;
        margin-right: -10px;
        flex-shrink: 0;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        color: var(--text-primary);
      }
      .nav-toggle-bar {
        position: absolute;
        left: 50%;
        width: 18px;
        height: 2px;
        margin-left: -9px;
        background: currentColor;
        transition:
          transform var(--duration-fast) var(--easing-default),
          opacity var(--duration-fast) var(--easing-default);
      }
      /* Three bars, centred on the 44px hit area at 6px spacing. */
      .nav-toggle-bar:nth-child(1) { top: 15px; }
      .nav-toggle-bar:nth-child(2) { top: 21px; }
      .nav-toggle-bar:nth-child(3) { top: 27px; }
      /* Collapse into an X while the drawer is open. */
      .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
      }
      .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
        opacity: 0;
      }
      .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
      }

      /* Slide-down drawer holding the nav links and the locale toggle. */
      .nav-drawer {
        display: none;
        position: fixed;
        top: 72px;
        left: 0;
        right: 0;
        z-index: 99;
        flex-direction: column;
        padding: var(--space-6);
        background: var(--bg-page);
        border-bottom: 1px solid var(--border-subtle);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        transform: translateY(-8px);
        opacity: 0;
        visibility: hidden;
        transition:
          transform var(--duration-fast) var(--easing-default),
          opacity var(--duration-fast) var(--easing-default),
          visibility var(--duration-fast) var(--easing-default);
      }
      .nav-drawer.open {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
      }
      .nav-drawer a {
        font-family: var(--font-sans);
        font-size: 16px;
        font-weight: 500;
        color: var(--text-secondary);
        text-decoration: none;
        padding: 0.85rem 0;
        border-bottom: 1px solid var(--border-subtle);
      }
      .nav-drawer a.active { color: var(--text-primary); }
      .nav-drawer .locale-toggle {
        display: flex;
        padding-top: 1.1rem;
      }
      .nav-drawer .locale-btn { font-size: 16px; }

      @media (prefers-reduced-motion: reduce) {
        .nav-toggle-bar, .nav-drawer { transition: none; }
      }

      @media (max-width: 640px) {
        .nav-items { display: none; }
        /* The desktop toggle hides; the drawer carries its own copy. */
        nav > .locale-toggle { display: none; }
        .nav-toggle { display: block; }
        .nav-drawer { display: flex; }
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/" class="masthead">Slovenský odliv<span class="masthead-diamond">&#9670;</span></a>
      <div class="nav-items">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[{ active: currentPath === item.href || currentPath.startsWith(item.href) }]}
            data-label-sk={item.label.sk}
            data-label-en={item.label.en}
          >
            {item.label[lang]}
          </a>
        ))}
      </div>
      <div class="locale-toggle" id="locale-toggle">
        <button type="button" class="locale-btn" data-locale="sk">SK</button>
        <span class="locale-separator">/</span>
        <button type="button" class="locale-btn" data-locale="en">EN</button>
      </div>
      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Menu"
        aria-controls="nav-drawer"
        aria-expanded="false"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </nav>
    <div class="nav-drawer" id="nav-drawer">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={[{ active: currentPath === item.href || currentPath.startsWith(item.href) }]}
          data-label-sk={item.label.sk}
          data-label-en={item.label.en}
        >
          {item.label[lang]}
        </a>
      ))}
      <div class="locale-toggle">
        <button type="button" class="locale-btn" data-locale="sk">SK</button>
        <span class="locale-separator">/</span>
        <button type="button" class="locale-btn" data-locale="en">EN</button>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <script is:inline>
      // Locale toggle wiring. Mirrors src/lib/locale.ts (STORAGE_KEY, EVENT).
      // React islands import the hook there; this drives the Astro-rendered
      // nav (toggle buttons + nav-item labels) and broadcasts the change.
      (function () {
        var KEY = 'sbd-locale';
        var EVENT = 'sbd-locale-change';

        function current() {
          var s = null;
          try { s = window.localStorage.getItem(KEY); } catch (e) {}
          return s === 'sk' || s === 'en' ? s : 'en';
        }

        function apply(loc) {
          document.documentElement.lang = loc;
          document.documentElement.setAttribute('data-locale', loc);
          document.querySelectorAll('.locale-btn').forEach(function (btn) {
            btn.classList.toggle('locale-active', btn.dataset.locale === loc);
          });
          document.querySelectorAll('.nav-items a, .nav-drawer a').forEach(function (a) {
            var label = loc === 'sk' ? a.dataset.labelSk : a.dataset.labelEn;
            if (label) a.textContent = label;
          });
        }

        function set(loc) {
          try { window.localStorage.setItem(KEY, loc); } catch (e) {}
          apply(loc);
          window.dispatchEvent(new CustomEvent(EVENT, { detail: loc }));
        }

        document.querySelectorAll('.locale-btn').forEach(function (btn) {
          btn.addEventListener('click', function () { set(btn.dataset.locale); });
        });
        // Keep nav in sync if an island changes locale, or another tab does.
        window.addEventListener(EVENT, function (e) { apply(e.detail || current()); });
        window.addEventListener('storage', function (e) { if (e.key === KEY) apply(current()); });

        apply(current());
      })();
    </script>
    <script is:inline>
      // Mobile nav drawer. The hamburger used to be a nav::after pseudo-element,
      // which is not in the DOM and so could never receive a click.
      (function () {
        var btn = document.getElementById('nav-toggle');
        var drawer = document.getElementById('nav-drawer');
        if (!btn || !drawer) return;

        function setOpen(open) {
          drawer.classList.toggle('open', open);
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          setOpen(btn.getAttribute('aria-expanded') !== 'true');
        });

        // Navigating is a full page load, but close anyway so the drawer is not
        // left open behind an in-page anchor jump.
        drawer.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () { setOpen(false); });
        });

        document.addEventListener('click', function (e) {
          if (!drawer.contains(e.target) && !btn.contains(e.target)) setOpen(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') setOpen(false);
        });
        // Leaving the mobile breakpoint reveals the desktop nav; drop the drawer
        // so it cannot linger as a floating panel over a wide layout.
        window.matchMedia('(max-width: 640px)').addEventListener('change', function (ev) {
          if (!ev.matches) setOpen(false);
        });
      })();
    </script>
  </body>
</html>

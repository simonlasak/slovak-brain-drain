---
interface Props {
  title: string;
  lang?: 'sk' | 'en';
}

const { title, lang = 'sk' } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/internal', label: { sk: 'Vnútorné', en: 'Internal' } },
  { href: '/corridor', label: { sk: 'Koridor', en: 'Corridor' } },
  { href: '/diaspora', label: { sk: 'Diaspora', en: 'Diaspora' } },
  { href: '/people', label: { sk: 'Ľudia', en: 'People' } },
  { href: '/resources', label: { sk: 'Zdroje', en: 'Resources' } },
  { href: '/methodology', label: { sk: 'Metodológia', en: 'Methodology' } },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/src/styles/tokens.css" />
    <script is:inline>
      // Set the active locale before first paint to avoid a flash of the
      // wrong language. Mirrors DEFAULT_LOCALE / STORAGE_KEY in src/lib/locale.ts.
      (function () {
        var stored = null;
        try { stored = window.localStorage.getItem('sbd-locale'); } catch (e) {}
        var loc = stored === 'sk' || stored === 'en' ? stored : 'en';
        document.documentElement.lang = loc;
        document.documentElement.setAttribute('data-locale', loc);
      })();
    </script>
    <style is:global>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: var(--font-sans);
        color: var(--text-primary);
        background: var(--bg-page);
        line-height: 1.6;
      }
      @keyframes ebb-drift {
        0%   { transform: translateX(0);   opacity: 0.6; }
        50%  { transform: translateX(6px); opacity: 0.3; }
        100% { transform: translateX(0);   opacity: 0.6; }
      }
      .masthead-diamond {
        animation: ebb-drift 8s ease-in-out infinite;
      }
      @media (prefers-reduced-motion: reduce) {
        .masthead-diamond { animation: none; opacity: 0.6; }
      }
    </style>
    <style>
      nav {
        position: sticky;
        top: 0;
        z-index: 100;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 var(--space-16);
        background: var(--bg-page);
        border-bottom: 1px solid var(--border-subtle);
      }
      @media (max-width: 1024px) {
        nav { padding: 0 var(--space-6); }
      }

      .masthead {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 18px;
        font-weight: 400;
        color: var(--text-primary);
        letter-spacing: -0.01em;
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .masthead:hover { color: var(--text-primary); }
      .masthead-diamond {
        display: inline-block;
        font-style: normal;
        font-size: 10px;
        margin-left: 12px;
        opacity: 0.6;
        vertical-align: middle;
        color: var(--accent-primary);
      }

      .nav-items {
        display: flex;
        align-items: center;
        gap: var(--space-8);
      }
      .nav-items a {
        position: relative;
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--text-secondary);
        text-decoration: none;
        white-space: nowrap;
        padding: 0;
        height: 72px;
        display: flex;
        align-items: center;
        transition: color var(--duration-fast) var(--easing-default);
      }
      .nav-items a:hover {
        color: var(--text-primary);
      }
      .nav-items a.active {
        color: var(--text-primary);
      }
      .nav-items a.active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--accent-primary);
      }

      .locale-toggle {
        display: flex;
        align-items: center;
        font-family: var(--font-sans);
        font-size: 14px;
        flex-shrink: 0;
      }
      .locale-btn {
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 400;
        color: var(--text-tertiary);
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        transition: color var(--duration-fast) var(--easing-default);
      }
      .locale-btn:hover {
        color: var(--text-primary);
      }
      .locale-btn.locale-active {
        color: var(--text-primary);
        font-weight: 500;
        cursor: default;
      }
      .locale-separator {
        color: var(--text-tertiary);
        font-weight: 400;
        margin: 0 6px;
      }

      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }

      @media (max-width: 640px) {
        .nav-items { display: none; }
        .locale-toggle { display: none; }
        nav::after {
          content: '';
          display: block;
          width: 16px;
          height: 14px;
          border-top: 2px solid var(--text-primary);
          border-bottom: 2px solid var(--text-primary);
          position: relative;
        }
        nav::after {
          background: linear-gradient(
            to bottom,
            transparent 0px, transparent 4px,
            var(--text-primary) 4px, var(--text-primary) 6px,
            transparent 6px
          );
          border-top: 2px solid var(--text-primary);
          border-bottom: 2px solid var(--text-primary);
        }
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/" class="masthead">Slovenský odliv<span class="masthead-diamond">&#9670;</span></a>
      <div class="nav-items">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[{ active: currentPath === item.href || currentPath.startsWith(item.href) }]}
            data-label-sk={item.label.sk}
            data-label-en={item.label.en}
          >
            {item.label[lang]}
          </a>
        ))}
      </div>
      <div class="locale-toggle" id="locale-toggle">
        <button type="button" class="locale-btn" data-locale="sk">SK</button>
        <span class="locale-separator">/</span>
        <button type="button" class="locale-btn" data-locale="en">EN</button>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <script is:inline>
      // Locale toggle wiring. Mirrors src/lib/locale.ts (STORAGE_KEY, EVENT).
      // React islands import the hook there; this drives the Astro-rendered
      // nav (toggle buttons + nav-item labels) and broadcasts the change.
      (function () {
        var KEY = 'sbd-locale';
        var EVENT = 'sbd-locale-change';

        function current() {
          var s = null;
          try { s = window.localStorage.getItem(KEY); } catch (e) {}
          return s === 'sk' || s === 'en' ? s : 'en';
        }

        function apply(loc) {
          document.documentElement.lang = loc;
          document.documentElement.setAttribute('data-locale', loc);
          document.querySelectorAll('.locale-btn').forEach(function (btn) {
            btn.classList.toggle('locale-active', btn.dataset.locale === loc);
          });
          document.querySelectorAll('.nav-items a').forEach(function (a) {
            var label = loc === 'sk' ? a.dataset.labelSk : a.dataset.labelEn;
            if (label) a.textContent = label;
          });
        }

        function set(loc) {
          try { window.localStorage.setItem(KEY, loc); } catch (e) {}
          apply(loc);
          window.dispatchEvent(new CustomEvent(EVENT, { detail: loc }));
        }

        document.querySelectorAll('.locale-btn').forEach(function (btn) {
          btn.addEventListener('click', function () { set(btn.dataset.locale); });
        });
        // Keep nav in sync if an island changes locale, or another tab does.
        window.addEventListener(EVENT, function (e) { apply(e.detail || current()); });
        window.addEventListener('storage', function (e) { if (e.key === KEY) apply(current()); });

        apply(current());
      })();
    </script>
  </body>
</html>

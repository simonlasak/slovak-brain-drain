---
interface Props {
  title: string;
  lang?: 'sk' | 'en';
}

const { title, lang = 'sk' } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: { sk: 'Domov', en: 'Home' } },
  { href: '/internal', label: { sk: 'Vnútorné', en: 'Internal' } },
  { href: '/corridor', label: { sk: 'Koridor', en: 'Corridor' } },
  { href: '/diaspora', label: { sk: 'Diaspora', en: 'Diaspora' } },
  { href: '/people', label: { sk: 'Ľudia', en: 'People' } },
  { href: '/resources', label: { sk: 'Zdroje', en: 'Resources' } },
  { href: '/methodology', label: { sk: 'Metodológia', en: 'Methodology' } },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/src/styles/tokens.css" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: var(--font-body);
        color: var(--color-text);
        background: var(--color-bg);
        line-height: 1.6;
      }
      nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--color-bg);
        border-bottom: 1px solid var(--color-border, #e5e5e5);
        padding: 0 1.5rem;
      }
      .nav-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        overflow-x: auto;
      }
      .nav-inner a {
        padding: 0.75rem 0.75rem;
        text-decoration: none;
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 500;
        white-space: nowrap;
        border-bottom: 2px solid transparent;
        transition: border-color 0.15s;
      }
      .nav-inner a:hover { border-bottom-color: var(--color-accent, #c44d2b); }
      .nav-inner a.active { border-bottom-color: var(--color-accent, #c44d2b); }
      .locale-toggle {
        margin-left: auto;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.4rem 0.6rem;
        border: 1px solid var(--color-border, #e5e5e5);
        border-radius: 4px;
        cursor: pointer;
        background: none;
      }
      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
      @media (max-width: 640px) {
        .nav-inner { gap: 0; }
        .nav-inner a { font-size: 0.75rem; padding: 0.75rem 0.5rem; }
      }
    </style>
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        {navItems.map(item => (
          <a href={item.href} class:list={[{ active: currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) }]}>
            {item.label[lang]}
          </a>
        ))}
        <button class="locale-toggle" id="locale-toggle">
          {lang === 'sk' ? 'EN' : 'SK'}
        </button>
      </div>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
